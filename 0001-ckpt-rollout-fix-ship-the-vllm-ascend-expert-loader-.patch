+         self,
+         layer: torch.nn.Module,
+diff --git a/vllm_ascend/ops/fused_moe/online_update.py b/vllm_ascend/ops/fused_moe/online_update.py
+new file mode 100644
+index 0000000..4aa24d3
+--- /dev/null
++++ b/vllm_ascend/ops/fused_moe/online_update.py
+@@ -0,0 +1,149 @@
++#
++# Copyright (c) 2026 Huawei Technologies Co., Ltd. All Rights Reserved.
++# This file is a part of the vllm-ascend project.
++#
++# Licensed under the Apache License, Version 2.0 (the "License");
++# you may not use this file except in compliance with the License.
++# You may obtain a copy of the License at
++#
++#     http://www.apache.org/licenses/LICENSE-2.0
++#
++# Unless required by applicable law or agreed to in writing, software
++# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
++# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
++# License for the specific language governing permissions and limitations
++# under the License.
++"""Sparse online-update layout window for fused-expert weights.
++
++vllm-ascend transposes fused-expert weights after load
++(``process_weights_after_loading``: ``transpose(1, 2)`` per w13/w2, plus
++conditional NZ / per-expert-list variants). Sparse in-place updates address
++tensors at checkpoint coordinates, so a sparse update window must flip the
++live expert weights back to checkpoint layout and replay the load-time
++transforms when it closes. The pad step is a no-op on NPU (vllm core
++``_maybe_pad_weight`` is ROCm-only), so the window is a pure shape
++permutation.
++
++0.23.0rc1 backport of the ``routed_experts.py``-generation contract:
++``WeightLayoutPolicy`` / ``get_current_hardware_profile`` and vllm core
++``replace_parameter`` may be absent on this generation, so the profile gate
++degrades to the ``is_310p`` check and rebinding falls back to plain
++``param.data`` assignment -- mirroring the host-classified trainer-side copy
++in verl (``moe_online_update.py``). ``rl_config`` does NOT force
++``weight_nz_mode`` to 0 on this generation, so the NZ gate message only
++points at ``--additional-config``.
++
++NOTE: on a 0.23.0 stack nothing calls the two contract methods yet (the
++vllm core ``FusedMoEMethodBase`` online-update hooks do not exist in this
++generation); verl's delta engine drives its own equivalent copy. This
++module exists so the host-side contract is present and importable.
++"""
++
++from __future__ import annotations
++
++import torch
++
++from vllm_ascend.ascend_config import get_ascend_config
++from vllm_ascend.utils import ACL_FORMAT_FRACTAL_NZ
++
++
++def _replace_parameter(layer: torch.nn.Module, name: str, tensor: torch.Tensor) -> None:
++    try:
++        from vllm.model_executor.utils import replace_parameter
++    except ImportError:
++        replace_parameter = None
++
++    if replace_parameter is not None:
++        replace_parameter(layer, name, tensor)
++    else:
++        getattr(layer, name).data = tensor
++
++
++def assert_layout_window_supported(layer) -> None:
++    """Fail loud unless this layer's post-load state matches the ND main path.
++
++    Enforcing gate: trainer-side sparse sessions bypass the worker's
++    ``_check_nz_disabled``, and the list-split variants delete the parameter
++    body, leaving no in-place write target.
++    """
++    for list_attr in ("w13_weight_list", "w2_weight_list"):
++        if getattr(layer, list_attr, None) is not None:
++            raise NotImplementedError(
++                f"Per-expert weight list variant ({list_attr}; megamoe/dynamic-eplb fused-MC2) deletes the "
++                "parameter body, leaving no in-place write target for sparse patches."
++            )
++    w13 = getattr(layer, "w13_weight", None)
++    w2 = getattr(layer, "w2_weight", None)
++    if not isinstance(w13, torch.nn.Parameter) or not isinstance(w2, torch.nn.Parameter):
++        raise NotImplementedError(
++            f"Unexpected expert weight binding on {type(layer).__name__}: expected Parameter-typed "
++            "w13_weight/w2_weight."
++        )
++    if w13.dim() != 3 or w2.dim() != 3:
++        raise NotImplementedError(
++            f"Unexpected expert weight rank on {type(layer).__name__}: w13{tuple(w13.shape)} / "
++            f"w2{tuple(w2.shape)}; the transform expects 3D [E, 2N, K] / [E, K, N] tensors."
++        )
++    if w13.dtype != torch.bfloat16 or w2.dtype != torch.bfloat16:
++        raise NotImplementedError(
++            f"Expert weights must be BF16 for the sparse layout window, got w13={w13.dtype} w2={w2.dtype}."
++        )
++    nz_mode = getattr(get_ascend_config(), "weight_nz_mode", 0)
++    if nz_mode:
++        # Conservative on purpose: mode 1 leaves BF16 in ND, but the session
++        # gate contract (worker _check_nz_disabled semantics) rejects any NZ
++        # mode so only the certified configuration reaches the window.
++        # 0.23.0rc1: rl_config does not force weight_nz_mode to 0 on this
++        # generation, so --additional-config is the only lever.
++        raise NotImplementedError(
++            f"weight_nz_mode={nz_mode} fails the NZ session gate; sparse in-place updates require "
++            f"weight_nz_mode=0 (verified configuration; {ACL_FORMAT_FRACTAL_NZ} storage has no verified "
++            "inverse). Set it via --additional-config."
++        )
++    try:
++        # 0.23.x hosts expose is_310p in utils; newer generations express the
++        # same constraint through the hardware profile below.
++        from vllm_ascend.utils import is_310p
++
++        if is_310p():
++            raise NotImplementedError(
++                "310P stores expert weights in FRACTAL_NZ unconditionally; sparse in-place updates are not "
++                "supported on this hardware profile."
++            )
++    except ImportError:
++        pass
++    try:
++        # Post-0.23 generations only: FORCE_NZ hardware profiles. Absent on
++        # 0.23.0rc1, where the 310P check above is the profile equivalent.
++        from vllm_ascend.utils import WeightLayoutPolicy, get_current_hardware_profile
++
++        if get_current_hardware_profile().weight_layout_policy is WeightLayoutPolicy.FORCE_NZ:
++            raise NotImplementedError(
++                "The hardware profile forces FRACTAL_NZ expert weight storage; sparse in-place updates are not "
++                "supported on this profile."
++            )
++    except ImportError:
++        pass
++
++
++def prepare_expert_weights_for_online_update(layer) -> None:
++    """Flip one layer's expert weights: runtime [E, K, 2N] -> checkpoint [E, 2N, K]."""
++    assert_layout_window_supported(layer)
++    w13 = layer.w13_weight.data
++    w2 = layer.w2_weight.data
++    # Build the checkpoint-layout copies first, then release the runtime
++    # storages: transient overhead stays at this single layer's size.
++    ckpt_w13 = w13.transpose(1, 2).contiguous()
++    ckpt_w2 = w2.transpose(1, 2).contiguous()
++    _replace_parameter(layer, "w13_weight", ckpt_w13)
++    _replace_parameter(layer, "w2_weight", ckpt_w2)
++
++
++def restore_expert_weights_after_online_update(layer) -> None:
++    """Replay the load-time transform for one layer (ND main path)."""
++    w13 = layer.w13_weight.data
++    w2 = layer.w2_weight.data
++    runtime_w13 = w13.transpose(1, 2).contiguous()
++    runtime_w2 = w2.transpose(1, 2).contiguous()
++    _replace_parameter(layer, "w13_weight", runtime_w13)
++    _replace_parameter(layer, "w2_weight", runtime_w2)
diff --git a/verl/workers/rollout/vllm_rollout/moe_online_update.py b/verl/workers/rollout/vllm_rollout/moe_online_update.py
index 2fa34d84..19e8c537 100644
--- a/verl/workers/rollout/vllm_rollout/moe_online_update.py
+++ b/verl/workers/rollout/vllm_rollout/moe_online_update.py
@@ -159,6 +159,17 @@ def iter_expert_weight_modules(model: torch.nn.Module):
             yield module
 
 
+def _runtime_host_file() -> str:
+    """Best-effort path of the installed host fused-MoE module (diagnostics only)."""
+    for module_name in (_V023_HOST_MODULE, _ANCHORED_HOST_MODULE):
+        try:
+            module = import_module(module_name)
+        except ImportError:
+            continue
+        return str(getattr(module, "__file__", module_name))
+    return "unknown"
+
+
 def _assert_layer_supported(layer: torch.nn.Module) -> None:
     for list_attr in _LIST_SPLIT_ATTRS:
         if getattr(layer, list_attr, None) is not None:
@@ -190,12 +201,16 @@ def _assert_layer_supported(layer: torch.nn.Module) -> None:
     # expert flush dies with AttributeError mid-apply. Fail loud at window
     # open instead, with the fix pointer.
     if not hasattr(w13, "weight_loader") or not hasattr(w2, "weight_loader"):
+        host_file = _runtime_host_file()
         raise NotImplementedError(
             f"Expert weights on {type(layer).__name__} carry no weight_loader attribute: the host "
             "vllm-ascend rebinds transposed experts as fresh Parameters in process_weights_after_loading. "
             "The sparse apply re-enters model.load_weights, which reads param.weight_loader; apply the verl "
             "delta vllm-ascend patch (tests/special_npu/vllm_ascend_moe_online_update_0230rc1.patch) or "
-            "move to a host that preserves loader attributes across post-load transforms."
+            "move to a host that preserves loader attributes across post-load transforms. "
+            f"Runtime host module: {host_file} -- verify the patch is live in THAT file with "
+            f"grep -n 'Rebind through' {host_file} (no hit = the runtime install is unpatched; note that "
+            "reinstalling vllm-ascend wipes a patch applied inside site-packages)."
         )
 
 
