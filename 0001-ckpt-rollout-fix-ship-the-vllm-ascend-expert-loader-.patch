new file mode 100644
index 00000000..2ec9e440
--- /dev/null
+++ b/tests/special_npu/vllm_ascend_moe_online_update_0230rc1.patch
@@ -0,0 +1,200 @@
+diff --git a/vllm_ascend/ops/fused_moe/fused_moe.py b/vllm_ascend/ops/fused_moe/fused_moe.py
+index d7ea573..69584b4 100644
+--- a/vllm_ascend/ops/fused_moe/fused_moe.py
++++ b/vllm_ascend/ops/fused_moe/fused_moe.py
+@@ -113,10 +113,15 @@ class AscendUnquantizedFusedMoEMethod(UnquantizedFusedMoEMethod):
+         super(UnquantizedFusedMoEMethod, self).process_weights_after_loading(layer)
+ 
+         w13_data = self._maybe_pad_weight(layer.w13_weight.data).transpose(1, 2).contiguous()
+-        layer.w13_weight = torch.nn.Parameter(w13_data, requires_grad=False)
++        # Rebind through .data: keep the Parameter object so weight_loader and
++        # other load-time attributes survive. Sparse online updates re-enter
++        # model.load_weights, whose fused-expert loader reads param.weight_loader
++        # on the live parameters; a fresh Parameter drops the attribute and the
++        # first expert flush dies with AttributeError.
++        layer.w13_weight.data = w13_data
+ 
+         w2_data = self._maybe_pad_weight(layer.w2_weight.data).transpose(1, 2).contiguous()
+-        layer.w2_weight = torch.nn.Parameter(w2_data, requires_grad=False)
++        layer.w2_weight.data = w2_data
+ 
+         # TODO: Current dispatch_ffn_combine fusion operator ONLY supports NZ format.
+         # Therefore, we must cast weights to NZ when fusion is enabled.
+@@ -138,6 +143,22 @@ class AscendUnquantizedFusedMoEMethod(UnquantizedFusedMoEMethod):
+             layer.w13_weight.data = maybe_trans_nz(layer.w13_weight.data)
+             layer.w2_weight.data = maybe_trans_nz(layer.w2_weight.data)
+ 
++    def prepare_weights_for_online_update(self, layer) -> None:
++        """Sparse online-update contract (FusedMoEMethodBase): expose checkpoint layout."""
++        from vllm_ascend.ops.fused_moe.online_update import (
++            prepare_expert_weights_for_online_update,
++        )
++
++        prepare_expert_weights_for_online_update(layer)
++
++    def restore_weights_after_online_update(self, layer) -> None:
++        """Sparse online-update contract (FusedMoEMethodBase): replay transforms."""
++        from vllm_ascend.ops.fused_moe.online_update import (
++            restore_expert_weights_after_online_update,
++        )
++
++        restore_expert_weights_after_online_update(layer)
++
